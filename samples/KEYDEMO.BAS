10 ' KEYBOARD DEMO : INKEY$ / INP(&H41) / INP(&HE0-&HEC) / KEY TABLE / STICK
20 CLS:PRINT "KEY DEMO  (ESC TO QUIT)"
30 DEF SEG=0
40 K$=INKEY$
50 IF K$=CHR$(27) THEN 200
60 IF K$<>"" THEN LOCATE 0,3:PRINT "INKEY$ :";ASC(K$);"   "
70 LOCATE 0,4:PRINT "INP(&H41):";RIGHT$("0"+HEX$(INP(&H41)),2);"  "
80 LOCATE 0,5:PRINT "STICK(0):";STICK(0);" STRIG(0):";STRIG(0);"  "
90 LOCATE 0,6:PRINT "MATRIX  :";
100 FOR I=0 TO 15:PRINT RIGHT$("0"+HEX$(PEEK(&H52A+I)),2);" ";:NEXT
105 LOCATE 0,7:PRINT "E0-EC   :";:FOR I=0 TO 12:PRINT RIGHT$("0"+HEX$(INP(&HE0+I)),2);" ";:NEXT
106 IF INP(&HE9)=191 THEN LOCATE 0,8:PRINT "SPACE (E9h=191)" ELSE LOCATE 0,8:PRINT SPACE$(16)
110 GOTO 40
200 CLS:END
